# /etc/siloscope/siloscope.env — readable by root only (chmod 600).
# Restart after editing: systemctl restart siloscope

# Address Siloscope listens on. Sign-in uses a Silo administrator account;
# serve it over HTTPS if it is reachable from outside your network.
LISTEN_ADDR=:8091

# Silo base URL (no /api/v2 suffix) and a Full access admin API key.
SILO_URL=http://silo.lan:8080
SILO_API_KEY=sa_replace_me

# Optional: a second Silo key with only the admin:monitor:read scope, for live
# session events. Without it, Siloscope polls Silo every 15 seconds.
SILO_MONITOR_API_KEY=

# silo (default): sign in with a Silo administrator account. none: no sign-in,
# for use behind an authenticating reverse proxy.
AUTH_MODE=silo

# Reverse proxies whose X-Forwarded-For Siloscope believes, as a comma-separated
# list of CIDRs. The default covers nginx or Tailscale serve on this machine.
TRUSTED_PROXIES=

# Shared secret for one-click sign-in from the Siloscope plugin in Silo. Leave
# empty to use the one Siloscope generates (Settings → Open from Silo).
SILO_LAUNCH_SECRET=

# Optional Plex playback tracking. Needs outbound HTTPS to plex.tv for
# account linking.
PLEX_URL=
PLEX_TOKEN=

# Optional integrations.
IFD_URL=
IFD_API_KEY=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
ARR_REPLACEMENTS_ENABLED=false

# Push notifications need HTTPS in front of Siloscope.
PUSH_CONTACT=
